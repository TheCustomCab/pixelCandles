{
  "name": "homebridge-wled-candles",
  "displayName": "WLED Candles",
  "version": "0.1.1",
  "description": "HomeKit control for WLED candles: one tile with a dimmable light, gentle fades and a named list of looks (WLED presets).",
  "type": "module",
  "main": "dist/index.js",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "TheCustomCab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheCustomCab/pixelCandles.git",
    "directory": "homebridge"
  },
  "bugs": {
    "url": "https://github.com/TheCustomCab/pixelCandles/issues"
  },
  "homepage": "https://github.com/TheCustomCab/pixelCandles/tree/main/homebridge#readme",
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "wled",
    "candles",
    "candle",
    "homekit",
    "presets"
  ],
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0-beta.0",
    "node": "^20 || ^22 || ^24 || ^26"
  },
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "build:test": "rm -rf build-test && tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test build-test/test/",
    "dev": "npm run build && node scripts/dev-homebridge.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/ws": "^8.18.0",
    "homebridge": "1.8.4",
    "typescript": "~5.9.3"
  }
}
